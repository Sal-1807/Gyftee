*.tsbuildinfo
next-env.d.ts

# ─── OS / Editor ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# VS Code (keep .vscode/extensions.json and settings.json if shared, ignore the rest)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── Certs / Secrets ─────────────────────────────────────────────────────────
