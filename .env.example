# ─────────────────────────────────────────────────────────────────────────────
# Next.js (gyftee/.env.local)
# ─────────────────────────────────────────────────────────────────────────────

# Public PocketBase URL — used client-side (must be reachable from the browser)
# Dev:  http://127.0.0.1:8090  or your LAN IP
# Prod: https://<your-project>.pockethost.io
NEXT_PUBLIC_POCKETBASE_URL=https://your-project.pockethost.io

# Internal ML service URL — used server-side only (Next.js API route → ML)
# Dev:  http://127.0.0.1:8000
# Prod: https://your-ml-service.railway.app  (or Fly.io / Render URL)
ML_SERVICE_URL=https://your-ml-service.railway.app

# Unsplash API key for gift image search (used in AddGiftModal)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# PocketBase admin credentials — used server-side by the ML service to read swipes
# Set these in Vercel dashboard as well if any server-side Next.js route needs admin access
POCKETBASE_ADMIN_EMAIL=admin@your-project.dev
POCKETBASE_ADMIN_PASSWORD=your_strong_password_here


# ─────────────────────────────────────────────────────────────────────────────
# ML service (ml-service/.env)
# ─────────────────────────────────────────────────────────────────────────────

# PocketBase URL reachable from the ML service (internal network or public)
POCKETBASE_URL=https://your-project.pockethost.io

# Same admin credentials as above — ML service authenticates as admin to read swipes
POCKETBASE_ADMIN_EMAIL=admin@your-project.dev
POCKETBASE_ADMIN_PASSWORD=your_strong_password_here

# Allowed CORS origin for the ML service — set to your Vercel deployment URL
FRONTEND_URL=https://gyftee.vercel.app


# ─────────────────────────────────────────────────────────────────────────────
# PocketBase (no .env — configured via admin UI or CLI flags)
# ─────────────────────────────────────────────────────────────────────────────
# PocketHost manages these automatically. For self-hosted:
#   ./pocketbase serve --http=0.0.0.0:8090
#   Admin credentials are set on first run via the setup UI.
